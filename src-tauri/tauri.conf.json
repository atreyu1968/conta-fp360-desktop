{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CONTA FP360 Studio",
  "version": "2.2.0",
  "identifier": "es.atreyuserviciosdigitales.contafp360.studio",
  "build": {
    "frontendDist": "../web/studio"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CONTA FP360 Studio · Profesorado",
        "width": 1400,
        "height": 900,
        "minWidth": 970,
        "minHeight": 660,
        "center": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
