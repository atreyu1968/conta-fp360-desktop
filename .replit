modules = ["nodejs-24", "python-base-3.13", "php-8.4", "rust-stable"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["cargo-tauri", "file", "freetype", "fuse", "gitFull", "lcms2", "libayatana-appindicator", "libimagequant", "libjpeg", "librsvg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "openssl", "patchelf", "pkg-config", "playwright-driver", "rustup", "tcl", "tk", "webkitgtk_4_1", "xdo", "xdotool", "zlib", "xdg-utils", "age"]
