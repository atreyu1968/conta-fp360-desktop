Options -Indexes
# Protección de configuración y archivos privados, incluidas copias y
# configuraciones temporales mientras el instalador las actualiza.
<FilesMatch "^(config(\..*)?|paypal\.php|README\.md|schema\.sql|.*\.(?:sqlite3?|db|bak|key|log|env))$">
 Require all denied
</FilesMatch>
<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set Referrer-Policy "no-referrer"
 Header always set X-Frame-Options "DENY"
</IfModule>
# Algunos alojamientos cPanel/FastCGI no envían Authorization a PHP.
# Mantener el token Bearer en el encabezado, nunca como parámetro URL.
<IfModule mod_setenvif.c>
 SetEnvIfNoCase Authorization "^(.+)$" HTTP_AUTHORIZATION=$1
</IfModule>
<IfModule mod_rewrite.c>
 RewriteEngine On
 RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
